[0.000, "o", "\r\n"]
[0.002, "o", "\u001b[1m  \u001b[0m\u001b[1m#   \u001b[0m\u001b[1m  \u001b[0m\u001b[1m  \u001b[0m\u001b[1mType       \u001b[0m\u001b[1m  \u001b[0m\u001b[1m  \u001b[0m\u001b[1mDescription                                          \u001b[0m\u001b[1m  \u001b[0m\r\n\u001b[2m  \u001b[0m\u001b[2m1   \u001b[0m\u001b[2m  \u001b[0m  bambu-lan      Bambu Lab printer via LAN (direct connection)          \r\n\u001b[2m  \u001b[0m\u001b[2m2   \u001b[0m\u001b[2m  \u001b[0m  bambu-cloud    Bambu Lab printer via cloud (requires cloud login)     \r\n\u001b[2m  \u001b[0m\u001b[2m3   \u001b[0m\u001b[2m  \u001b[0m  moonraker      Klipper/Moonraker printer via REST API (experimental)  \r\n"]
